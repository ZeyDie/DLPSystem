PROFILE=dev

# Application Settings
APP_NAME=DLPSystem
APP_VERSION=1.0.0
LOG_LEVEL=INFO

JDBC_URL=jdbc:sqlserver://localhost:1433;databaseName=DLP;encrypt=true;trustServerCertificate=true;loginTimeout=30;integratedSecurity=false;
JDBC_USERNAME=sa
JDBC_PASSWORD=password
JDBC_DRIVER=com.microsoft.sqlserver.jdbc.SQLServerDriver

DB_SHOW_SQL=true
DB_DDL_AUTO=update
DB_DIALECT=org.hibernate.dialect.SQLServerDialect

CORS_ENABLED=true
CORS_ALLOWED_CREDENTIALS=true
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_HEADERS=*
CORS_ALLOWED_METHODS=*

CSRF_ENABLED=false

LDAP_ENABLED=false
LDAP_DOMAIN=corp.domain.com
LDAP_URL=ldap://localhost:389
LDAP_BASE=DC=corp,DC=domain,DC=com
LDAP_USERNAME=CORP\\LDAP
LDAP_PASSWORD=password
LDAP_PATH_PC=OU=Computers
LDAP_PATH_USERS=OU=Users